<div class="oak-announcement">
  {{ section.settings.announcement | escape }}
</div>

<header class="oak-header">
  <div class="oak-header__inner page-width">
    <button class="oak-icon-button oak-mobile-toggle" type="button" data-mobile-menu-toggle aria-expanded="false" aria-label="Open menu">
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>

    <a class="oak-logo" href="{{ routes.root_url }}">
      {% if settings.logo %}
        {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name, loading: 'eager' }}
      {% else %}
        <img src="{{ 'oak-logo.png' | asset_url }}" alt="{{ shop.name }}" width="150" height="56" loading="eager">
      {% endif %}
    </a>

    <nav class="oak-nav" aria-label="Main navigation">
      <ul class="oak-nav__list">
        {% for link in linklists[settings.main_menu].links %}
          <li>
            <a class="oak-nav__link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="oak-actions">
      <a class="oak-icon-button" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">
        <svg width="23" height="23" viewBox="0 0 24 24" aria-hidden="true"><path d="m20 20-4.4-4.4M18 10.5a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </a>
      <a class="oak-icon-button" href="{{ routes.account_url }}" aria-label="Account">
        <svg width="23" height="23" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </a>
      <a class="oak-icon-button" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}" data-cart-trigger>
        <svg width="25" height="25" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8h12l-1 11H6L5 4H3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 8a3 3 0 0 1 6 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <nav class="oak-mobile-drawer page-width" data-mobile-menu aria-label="Mobile navigation">
    <ul>
      {% for link in linklists[settings.main_menu].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement text",
      "default": "Enjoy Free shipping and Free Returns!"
    }
  ]
}
{% endschema %}
