{% liquid
  assign collection = section.settings.collection
%}

<section class="oak-section">
  <div class="page-width">
    <div class="oak-section__header">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="oak-grid">
      {% assign rendered_products = 0 %}
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.limit %}
          {% assign rendered_products = rendered_products | plus: 1 %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for product in collections.all.products limit: section.settings.limit %}
          {% assign rendered_products = rendered_products | plus: 1 %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% endif %}
    </div>
    {% if rendered_products == 0 %}
      <div class="oak-empty-state">
        <h3>No products to show yet</h3>
        <p>Add products to this Shopify store or select a populated collection in the theme editor.</p>
        <a class="oak-button oak-button--outline" href="{{ routes.all_products_collection_url }}">View catalog</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Oak & Lily"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Considered spaces, soft cottons, and fresh combinations."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
